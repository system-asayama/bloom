# コピーして .env を作成: cp .env.example .env
# セッション署名用の秘密鍵(python -c "import secrets; print(secrets.token_hex(32))" で生成)
SECRET_KEY=change-me
# 初回起動時に作成される管理者アカウント(作成後はパスワード変更画面から変更可能)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 店名(サイト上部に表示)
SITE_NAME=bloom
# HTTPS で公開する場合は 1
SESSION_COOKIE_SECURE=0
